NODE_ENV=development
PORT=4000

# Local:  mongodb://127.0.0.1:27017/pharm36
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/pharm36
MONGODB_URI=mongodb://127.0.0.1:27017/pharm36

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (admin web portal). Mobile apps are not affected by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# If true, drug categories that need an extra section (controlled drugs, veterinary...) are only
# unlocked after the council admin has confirmed that section (recommended).
# If false, the sections the professional ticked at sign-up unlock immediately.
REQUIRE_SECTION_VERIFICATION=true

# Daily expiry scan + notifications
ENABLE_CRON=true
CRON_SCHEDULE=0 6 * * *
CRON_TIMEZONE=Africa/Lagos

# Sales level thresholds (revenue in NGN over the last 30 days): >= HIGH => high, >= MEDIUM => medium, else low
SALES_LEVEL_HIGH=8000
SALES_LEVEL_MEDIUM=3000

# Used by `npm run seed:admin`
ADMIN_EMAIL=admin@pharm36.app
ADMIN_PASSWORD=ChangeMe123
ADMIN_COUNCIL=ALL
